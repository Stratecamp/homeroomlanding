# Fonts are self-hosted and content-stable. A year is the normal lifetime;
# if a face ever changes, the filename changes with it.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Images are stable too, but keep them shorter so a new share card or icon
# reaches the crawlers without waiting a year.
/og-image.png
  Cache-Control: public, max-age=604800
/og-founding.png
  Cache-Control: public, max-age=604800
/og-hello.png
  Cache-Control: public, max-age=604800
/apple-touch-icon.png
  Cache-Control: public, max-age=604800
/favicon*.png
  Cache-Control: public, max-age=604800

# The pages themselves must not be cached hard, or a copy fix takes a week
# to show up.
/*.html
  Cache-Control: public, max-age=0, must-revalidate
